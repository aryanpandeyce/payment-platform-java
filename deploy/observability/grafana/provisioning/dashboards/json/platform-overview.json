      "id": 3,
      "title": "HTTP 5xx Error Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) / (sum(rate(http_server_requests_seconds_count[1m])) + 0.001)",
          "legendFormat": "5xx Ratio",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
