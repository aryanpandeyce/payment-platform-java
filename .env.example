# ==========================================
# ApexPay Platform Environment Configuration
# ==========================================

# 1. Databases Credentials
POSTGRES_USER=payments
POSTGRES_PASSWORD=change_me
MONGO_USER=audit
MONGO_PASSWORD=change_me

# 2. Identity & JWT Security
JWT_SECRET=supersecretjwtkeythatisatleast256bitslongforhmacsha256signing
SEED_ADMIN_PASSWORD=Admin@ApexPay2026!
SEED_USER_PASSWORD=User@ApexPay2026!

# 3. Fraud Detection Limits
FRAUD_MAX_AMOUNT=50000.00
FRAUD_MAX_VELOCITY=5

# 4. Optional SonarQube & Observability Stack (docker-compose.quality.yml)
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=change_me
SONAR_TOKEN=squ_local_development_token_for_ci